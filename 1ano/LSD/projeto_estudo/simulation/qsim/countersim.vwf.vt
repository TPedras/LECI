`timescale 1 ps/ 1 ps
module counter_vlg_vec_tst();
// constants                                           
// general purpose registers
reg clk;
reg frz;
reg rst;
// wires                                               
wire [3:0] count;
wire sinal;

// assign statements (if any)                          
counter i1 (
// port map - connection between master ports and signals/registers   
	.clk(clk),
	.count(count),
	.frz(frz),
	.rst(rst),
	.sinal(sinal)
);
initial 
begin 
#1000000 $finish;
end 

// clk
always
begin
	clk = 1'b0;
	clk = #10000 1'b1;
	#10000;
end 

// frz
initial
begin
	frz = 1'b1;
	frz = #30000 1'b0;
	frz = #30000 1'b1;
	frz = #30000 1'b0;
end 

// rst
initial
begin
	rst = 1'b0;
	rst = #130000 1'b1;
	rst = #30000 1'b0;
end 
endmodule

