library IEEE;
use ieee.std_logic_1164.all;
use ieee.numeric_std.all;

entity Bin2Bcd is
			port
			(
		hexIn   : in  std_logic_vector(3 downto 0);
		sinal   : in std_logic;
		decOut0 : out std_logic_vector(3 downto 0);
		decOut1 : out std_logic_vector(3 downto 0)
			);
end Bin2Bcd;

architecture behavioral of Bin2Bcd is
signal s_hexIn : unsigned(3 downto 0);
begin
	process (hexIn) is
	begin
			s_hexIn <= hexIn;
			if sinal = '1' and s_hexIn = not "1111" then
				s_hexIn <= s_hexIn + 1;
			else
				decOut1 <= "0001";
				decOut0 <= "0110"
				end process;
			
			if s_hexIn < "1010" then
				decOut0 <= s_hexIn;
				decOut1 <= "0000";
			else
				if s_hexIn = "1010" then
					decOut0 <= "0000";
				elsif s_hexIn = "1011" then
					decOut0 <= "0001";
				elsif s_hexIn = "1100" then
					decOut0 <= "0010";
				elsif s_hexIn = "1101" then
					decOut0 <= "0011";
				elsif s_hexIn = "1110" then
					decOut0 <= "0100";
				else
					decOut0 <= "0101";
				end if;
				decOut1 <= "0001";
		end if;
	end process;
end Behavioral;