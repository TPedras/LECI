library IEEE;
use IEEE.STD_LOGIC_1164.ALL;

entity clock_generator is
  port(
    CLOCK_50    : in  std_logic;
    pulse_1hz   : out std_logic;
    pulse_2hz   : out std_logic;
    pulse_0_25hz : out std_logic
  );
end clock_generator;

architecture structural of clock_generator is
begin
  -- 1 Hz (50 milhões de ciclos)
  gen_1hz: entity work.pulse_gen
    generic map(MAX => 50_000_000)
    port map(clk => CLOCK_50, pulse => pulse_1hz);

  -- 2 Hz (25 milhões de ciclos)
  gen_2hz: entity work.pulse_gen
    generic map(MAX => 25_000_000)
    port map(clk => CLOCK_50, pulse => pulse_2hz);

  -- 0.25 Hz (200 milhões de ciclos)
  gen_0_25hz: entity work.pulse_gen
    generic map(MAX => 200_000_000)
    port map(clk => CLOCK_50, pulse => pulse_0_25hz);
end structural;